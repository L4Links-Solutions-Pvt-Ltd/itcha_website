# Postgres (Neon). Required. In Vercel, adding the Neon integration sets this automatically.
DATABASE_URL=

# Signs the admin session cookie. Required. Generate with: openssl rand -base64 48
SESSION_SECRET=

# First admin account, created by the migration on build ONLY if no admin exists yet.
# Remove these from Vercel after the first successful deploy and change the password in the dashboard.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# --- Optional notification channels (dashboard shows which are configured) ---
# Email via ZeptoMail
ZEPTO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ITCHA

# WhatsApp via Interakt. Needs an APPROVED template whose body has
# {{1}} = member name and {{2}} = notice title.
INTERAKT_API_KEY=
INTERAKT_NOTICE_TEMPLATE=
INTERAKT_TEMPLATE_LANG=en

# Where new membership applications / enquiries are emailed (needs the email channel)
ADMIN_NOTIFY_EMAIL=

# Public site URL, used in emails
SITE_URL=https://itcha.org
